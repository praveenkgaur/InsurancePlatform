@using Microsoft.AspNetCore.Components.Authorization
@using Insurance.UI.BlazorWasm.Authentication
@using Insurance.UI.BlazorWasm.Services
@inject AuthenticationStateProvider AuthState
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Insurance Platform</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="claims">Claims</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="policies">Policies</NavLink>
                </div>
                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <div class="nav-item px-3">
                        <span class="nav-link">Admin</span>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="Logout">Sign out</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Login</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task Logout()
    {
        await Auth.LogoutAsync();
        ((ApiAuthenticationStateProvider)AuthState).NotifySignedOut();
        Navigation.NavigateTo("/login");
    }
}
