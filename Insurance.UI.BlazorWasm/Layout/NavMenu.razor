@using Microsoft.AspNetCore.Components.Authorization

<div class="brand-row">
    <a class="navbar-brand" href="">
        <span class="brand-mark">IP</span>
        <span class="brand-text">Insurance<br />Platform</span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-section">Overview</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-ico" aria-hidden="true">⌂</span> Dashboard
                    </NavLink>
                </div>

                <div class="nav-section">Work</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="claims" Match="NavLinkMatch.All">
                        <span class="nav-ico" aria-hidden="true">▣</span> Claims
                    </NavLink>
                </div>
                <div class="nav-item px-3 nested">
                    <NavLink class="nav-link" href="claims/new">
                        <span class="nav-ico" aria-hidden="true">＋</span> Add claim
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="claimants" Match="NavLinkMatch.All">
                        <span class="nav-ico" aria-hidden="true">◉</span> Claimants
                    </NavLink>
                </div>
                <div class="nav-item px-3 nested">
                    <NavLink class="nav-link" href="claimants/new">
                        <span class="nav-ico" aria-hidden="true">＋</span> Add claimant
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="policies">
                        <span class="nav-ico" aria-hidden="true">▤</span> Policies
                    </NavLink>
                </div>

                <div class="nav-section">Alerts</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notifications">
                        <span class="nav-ico" aria-hidden="true">◉</span> Notifications
                    </NavLink>
                </div>
                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <div class="nav-section">Admin</div>
                    <div class="nav-item px-3">
                        <span class="nav-link muted">Administrator</span>
                    </div>
                </AuthorizeView>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Login</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
