@page "/claimants/new"
@page "/claimants"
@using Insurance.Contracts.Claims
@using Insurance.UI.BlazorWasm.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ClaimsService ClaimsApi

<PageTitle>Add claimant</PageTitle>
<h1>Add claimant</h1>
<p class="text-muted">Creates a row in dbo.InsuranceClaimants so you can attach it when adding a claim.</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(saved ? "alert-success" : "alert-warning")">@message</div>
}

<div class="card mb-4" style="max-width: 960px;">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">First name</label>
                <input class="form-control" @bind="form.FirstName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Last name</label>
                <input class="form-control" @bind="form.LastName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Full name (optional)</label>
                <input class="form-control" @bind="form.FullName" placeholder="Filled from first + last if empty" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Date of birth</label>
                <input class="form-control" type="date" @bind="form.DateOfBirth" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Gender</label>
                <select class="form-select" @bind="form.Gender">
                    <option value="">Select</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                    <option value="Prefer not to say">Prefer not to say</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input class="form-control" @bind="form.Email" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Phone</label>
                <input class="form-control" @bind="form.Phone" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Alternate phone</label>
                <input class="form-control" @bind="form.AlternatePhone" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Address line 1</label>
                <input class="form-control" @bind="form.AddressLine1" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Address line 2</label>
                <input class="form-control" @bind="form.AddressLine2" />
            </div>
            <div class="col-md-4">
                <label class="form-label">City</label>
                <input class="form-control" @bind="form.City" />
            </div>
            <div class="col-md-4">
                <label class="form-label">State</label>
                <input class="form-control" @bind="form.StateName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">PIN</label>
                <input class="form-control" @bind="form.PinCode" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Country</label>
                <input class="form-control" @bind="form.Country" />
            </div>
            <div class="col-md-4">
                <label class="form-label">ID type</label>
                <select class="form-select" @bind="form.IdType">
                    <option value="">Select</option>
                    <option value="Aadhaar">Aadhaar</option>
                    <option value="PAN">PAN</option>
                    <option value="Passport">Passport</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">ID number</label>
                <input class="form-control" @bind="form.IdNumber" />
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <input class="form-control" @bind="form.Notes" />
            </div>
            <div class="col-12">
                <button class="btn btn-primary" @onclick="Save" disabled="@busy">Save claimant</button>
            </div>
        </div>
    </div>
</div>

<h2>Existing claimants</h2>
@if (rows is null)
{
    <p>Loading...</p>
}
else if (rows.Length == 0)
{
    <p>No claimants yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>City</th>
                <th>PIN</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.ClaimantId</td>
                    <td>@row.FullName</td>
                    <td>@row.Email</td>
                    <td>@row.Phone</td>
                    <td>@row.City</td>
                    <td>@row.PinCode</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private InsuranceClaimantDto[]? rows;
    private CreateClaimantRequest form = new();
    private string? message;
    private bool saved;
    private bool busy;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() => rows = await ClaimsApi.GetClaimantsAsync() ?? [];

    private async Task Save()
    {
        message = null;
        saved = false;
        form.EnsureFullName();
        if (string.IsNullOrWhiteSpace(form.FirstName) || string.IsNullOrWhiteSpace(form.LastName))
        {
            message = "First name and last name are required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(form.AddressLine1) || string.IsNullOrWhiteSpace(form.City))
        {
            message = "Address line 1 and city are required.";
            return;
        }

        busy = true;
        var (ok, error) = await ClaimsApi.CreateClaimantAsync(form);
        busy = false;
        if (!ok)
        {
            message = string.IsNullOrWhiteSpace(error) ? "Save failed. Run Sql/007_ClaimantsExtended.sql on DemoDataBase if columns are missing." : error;
            return;
        }

        saved = true;
        message = $"Saved {form.FullName}.";
        form = new CreateClaimantRequest();
        await Load();
    }
}
