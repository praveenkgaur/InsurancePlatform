{
  "ConnectionStrings": {
    "DemoDataBase": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DemoDataBase;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "InsurancePlatform",
    "Audience": "InsuranceApis",
    "SigningKey": "InsurancePlatform-dev-signing-key-32ch",
    "AccessTokenMinutes": 30
  },
  "Functions": {
    "Enabled": false,
    "ClaimantCreatedUrl": "",
    "HostKey": ""
  },
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*",
  "Resilience": {
    "Retry": {
      "Enabled": true,
      "MaxRetries": 3
    },
    "CircuitBreaker": {
      "Enabled": true,
      "MinimumThroughput": 5,
      "BreakSeconds": 30
    },
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Idempotency": {
      "Enabled": true,
      "HeaderName": "Idempotency-Key",
      "TtlHours": 24
    }
  }
}
