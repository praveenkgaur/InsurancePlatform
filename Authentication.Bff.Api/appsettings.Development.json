{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Agent": {
    "UseSemanticKernel": true,
    "Mode": "Multi",
    "Orchestrator": "Coordinator",
    "Intake": {
      "Enabled": true,
      "RequireAmount": true,
      "DefaultProduct": "Motor"
    },
    "Agents": {
      "Claimant": {
        "Enabled": true,
        "DisplayName": "Claimant agent",
        "Tools": [ "claimants.CreateClaimant", "claimants.GetClaimants" ]
      },
      "Policy": {
        "Enabled": true,
        "DisplayName": "Policy agent",
        "Tools": [ "policies.CreatePolicy", "policies.GetPolicies" ]
      },
      "Claim": {
        "Enabled": true,
        "DisplayName": "Claim agent",
        "Tools": [ "claims.CreateClaim", "claimants.GetClaimants" ]
      }
    }
  }

}
